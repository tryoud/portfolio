---
// Head section.
//
// The portrait is a background-removed cut-out, so it cannot float on the page
// ground — a white shirt on warm paper has no edge, and the old layout let it
// read as a sticker with a watermark and a caption running across the sleeve.
// Here it gets a stage: a cool, dark studio backdrop it is photographed
// against, bleeding off the right and bottom of the viewport. The copy column
// stays on the page ground and carries the pitch alone.
const { site } = Astro.props;
const hero = site.hero ?? {};

const headline = String(hero.headline ?? "").trim();
const lead = String(hero.lead ?? hero.specialization ?? "").trim();
const ctaNote = String(hero.ctaNote ?? "").trim();
const portraitSrc = String(hero.portraitSrc ?? "").trim() || "/hero/Nikolas_Maerker_hero.webp";
const portraitAlt = String(hero.portraitAlt ?? "").trim() || site.name || "";

const primaryCta = hero.primaryCta ?? {};
const secondaryCta = hero.secondaryCta ?? {};
const primaryHref = primaryCta.href ?? "#contact";
const primaryLabel = primaryCta.label ?? "Projekt anfragen";
const secondaryHref = secondaryCta.href ?? "#work";
const secondaryLabel = secondaryCta.label ?? "Projekte ansehen";
---

<section class="hero" id="hero" aria-labelledby="hero-heading">
  <div class="hero-grid">
    <div class="hero-copy">
      <h1 id="hero-heading" class="hero-title" data-rise>{headline}</h1>

      {lead ? (
        <p class="hero-lead" data-rise style="--rise-delay:90ms">{lead}</p>
      ) : null}

      <div class="hero-actions" data-rise style="--rise-delay:170ms">
        <a href={primaryHref} class="btn btn-primary">{primaryLabel}</a>
        <a href={secondaryHref} class="btn btn-secondary">{secondaryLabel}</a>
      </div>

      {ctaNote ? (
        <p class="hero-note" data-rise style="--rise-delay:230ms">{ctaNote}</p>
      ) : null}
    </div>

    <div class="hero-stage">
      <img
        class="hero-portrait"
        src={portraitSrc}
        alt={portraitAlt}
        width="2300"
        height="2711"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<script is:inline>
  // One orchestrated entrance, run once on load. The hidden start state is set
  // from script so the hero is fully visible when JS is unavailable.
  (function () {
    var hero = document.getElementById("hero");
    if (!hero) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    hero.classList.add("is-anim");
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        hero.classList.add("is-ready");
      });
    });
  })();
</script>
