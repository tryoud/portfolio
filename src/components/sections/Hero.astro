---
const { site } = Astro.props;
const hero = site.hero ?? {};
const headline = hero.headline ?? "Hey, there";
const portraitSrc = (hero.portraitSrc && String(hero.portraitSrc).trim()) || "/hero/Nikolas_Maerker_hero.webp";
const primaryCta = hero.primaryCta ?? { label: "Projekt anfragen", href: "#contact" };
const secondaryCta = hero.secondaryCta ?? { label: "Projekte ansehen", href: "#work" };
const primaryHref = typeof primaryCta === "object" && primaryCta.href ? primaryCta.href : "#contact";
const primaryLabel = typeof primaryCta === "object" && primaryCta.label ? primaryCta.label : "Projekt anfragen";
const secondaryHref = typeof secondaryCta === "object" && secondaryCta.href ? secondaryCta.href : "#work";
const secondaryLabel = typeof secondaryCta === "object" && secondaryCta.label ? secondaryCta.label : "Projekte ansehen";
const specialization = hero.specialization ?? "";
const specializationCopy = specialization || (Array.isArray(hero.specializationLines) ? hero.specializationLines.join(" ") : "");
const ctaNote = (hero.ctaNote && String(hero.ctaNote).trim()) || "";
const decorativeHeadline = String(hero.decorativeHeadline ?? "Hey, there").trim();
const nameLine = site.name ?? "";
const roleLine = site.role ?? "";
const roleSubline = (hero.roleSubline && String(hero.roleSubline).trim()) || "";
const nameParts = nameLine.trim().split(/\s+/);
const firstNameUpper = nameParts[0] ? nameParts[0].toUpperCase() : "";
const lastNameUpper = nameParts.length > 1 ? nameParts.slice(1).join(" ").toUpperCase() : "";
const roleSegments = roleLine.toUpperCase().split(/\s*·\s*/).filter(Boolean);
const roleLines = Array.isArray(hero.roleLines) && hero.roleLines.length ? hero.roleLines.map((l) => String(l).toUpperCase()) : roleSegments;
const rawHeadline = String(headline || "").trim();
const headlineLinesSource = Array.isArray(hero.headlineLines) && hero.headlineLines.length
  ? hero.headlineLines
  : rawHeadline.split(/,\s*/);
const headlineLines = headlineLinesSource.map((part) => String(part).trim()).filter(Boolean);
const heroHeadlineLines = headlineLines.length ? headlineLines : [headline];
const decorativeParts = decorativeHeadline.split(/,\s*/);
const decorativeLeft = decorativeParts[0] ? `${decorativeParts[0]},` : "Hey,";
const decorativeRight = decorativeParts[1] ?? "there";
const eyebrow = (hero.eyebrow && String(hero.eyebrow).trim()) || roleLines[0] || "WEB DESIGNER";
---

<section class="relative overflow-hidden bg-[var(--bg)] text-[var(--text)]" aria-labelledby="hero-heading" data-hero-motion>
  <!-- Warm ambient background -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 90% 70% at 70% 20%, hsla(38, 80%, 92%, 1) 0%, transparent 60%);"></div>
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 60% 50% at 10% 90%, hsla(30, 60%, 94%, 0.8) 0%, transparent 60%);"></div>
  </div>

  <div class="mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-y-2 px-4 pb-0 pt-10 sm:px-6 md:min-h-[calc(100svh-4.5rem)] md:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] md:gap-x-10 md:pt-6 lg:gap-x-16">

    <!-- ===== LEFT: copy ===== -->
    <div class="relative z-10 order-2 flex flex-col items-center pb-10 text-center md:order-1 md:items-start md:pb-24 md:text-left lg:pb-28">
      <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-[var(--brand)] md:text-xs">{eyebrow}</p>

      <h1 id="hero-heading" class="mt-4 font-display text-[clamp(2.4rem,9vw,4.6rem)] font-medium italic leading-[1.02] tracking-[-0.02em] text-[var(--text)] [text-wrap:balance]">
        {(hero.headlineTabletLines && Array.isArray(hero.headlineTabletLines) && hero.headlineTabletLines.length
          ? (Array.isArray(hero.headlineTabletLines) ? hero.headlineTabletLines : heroHeadlineLines)
          : heroHeadlineLines
        ).map((line) => <span class="block">{line}</span>)}
      </h1>

      {specializationCopy ? (
        <p class="mt-5 max-w-[34ch] text-[0.95rem] leading-relaxed text-[var(--muted)] md:max-w-[42ch] md:text-base [text-wrap:pretty]">
          {specializationCopy}
        </p>
      ) : null}

      <div class="mt-8 flex w-full max-w-[22rem] flex-col gap-3 md:max-w-none md:flex-row md:items-center">
        <a href={primaryHref} class="btn btn-primary hero-primary-cta md:px-7 md:py-3">
          {primaryLabel}
          <svg class="btn-arrow h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
        <a href={secondaryHref} class="btn btn-secondary md:px-7 md:py-3">{secondaryLabel}</a>
      </div>
      {ctaNote ? (
        <p class="mt-3 text-xs leading-snug text-[var(--muted-soft)]">{ctaNote}</p>
      ) : null}
    </div>

    <!-- ===== RIGHT: portrait ===== -->
    <div class="relative order-1 md:order-2 md:self-end">
      <!-- decorative watermark, tucked behind portrait -->
      <div class="pointer-events-none absolute -left-8 top-6 z-0 hidden select-none items-baseline gap-4 lg:flex xl:-left-16" aria-hidden="true">
        <span class="hero-parallax font-display text-[clamp(3rem,5vw,5.5rem)] font-medium italic leading-none tracking-[-0.02em] text-zinc-900/10" data-hero-layer="back">{decorativeLeft}</span>
        <span class="hero-parallax -ml-6 font-display text-[clamp(3rem,5vw,5.5rem)] font-medium italic leading-none tracking-[-0.02em] text-zinc-900/[0.06]" data-hero-layer="back">{decorativeRight}</span>
      </div>

      <div class="hero-parallax-soft relative z-10 mx-auto w-60 sm:w-72 md:w-auto md:max-w-none lg:translate-x-6" data-hero-layer="portrait">
        <img
          src={portraitSrc}
          alt=""
          class="mx-auto h-auto w-full object-contain object-bottom md:mx-0"
          width="480"
          height="640"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>

      <!-- name/role strip along portrait bottom, desktop only -->
      <div class="pointer-events-none absolute bottom-6 right-2 z-20 hidden max-w-[calc(100%-1rem)] md:block lg:bottom-8 lg:right-6" aria-hidden="true">
        <p class="font-display text-[clamp(1.4rem,2.2vw,2.1rem)] font-medium italic leading-none text-[var(--text)]">
          {nameLine}
        </p>
        <p class="mt-2 text-[0.6rem] font-semibold uppercase tracking-[0.2em] text-[var(--muted)] md:text-[0.65rem] lg:mt-2.5 lg:whitespace-nowrap lg:text-xs">
          {roleLines.join(" · ")}{roleSubline ? <span class="text-[var(--muted-soft)]"> · {roleSubline}</span> : null}
        </p>
      </div>
    </div>

    <!-- name/role strip, mobile only -->
    <p class="order-3 pb-2 text-center text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-[var(--muted)] md:hidden" aria-hidden="true">
      {nameLine} · {roleLines.join(" · ")}
    </p>
  </div>
</section>

<script>
  (function () {
    const section = document.querySelector("[data-hero-motion]");
    if (!section || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const backLayers = section.querySelectorAll('[data-hero-layer="back"]');
    const portrait = section.querySelector('[data-hero-layer="portrait"]');
    let ticking = false;

    function update() {
      ticking = false;
      const rect = section.getBoundingClientRect();
      const viewport = window.innerHeight || 1;
      const progress = Math.max(-1, Math.min(1, (viewport * 0.5 - rect.top) / viewport));

      backLayers.forEach((el) => el.style.setProperty("--parallax-y", `${Math.round(progress * -18)}px`));
      if (portrait) portrait.style.setProperty("--parallax-soft-y", `${Math.round(progress * 12)}px`);
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    }

    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
  })();
</script>
