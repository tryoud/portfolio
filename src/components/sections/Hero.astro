---
// Poster hero.
//
// Layer order, back to front: warm key light, the oversized surname, the
// portrait (which occludes the middle of that word), grain, a scrim that
// fades his white shirt into the ink, then the copy. The photograph is the
// ground here rather than an inset panel, so the stage stays dark in both
// themes — it is a lit photograph, not a surface that follows the page.
const { site } = Astro.props;
const hero = site.hero ?? {};

const headline = String(hero.headline ?? "").trim();
const lead = String(hero.lead ?? "").trim();
const ctaNote = String(hero.ctaNote ?? "").trim();
const tag = String(hero.tag ?? "").trim();
const portraitSrc = String(hero.portraitSrc ?? "").trim() || "/hero/Nikolas_Maerker_hero.webp";
const portraitAlt = String(hero.portraitAlt ?? "").trim() || site.name || "";

// Backdrop word. It gets partly hidden behind his head, so it has to be a word
// the reader already knows and can complete from the visible letters — a
// surname cannot be reconstructed, and says nothing to a first-time visitor.
// Opt-in via content: no wordmark configured means no backdrop word.
const wordmark = String(hero.wordmark ?? "").trim().toUpperCase();

// The trailing slice is wrapped separately so it can drop on scroll. Split
// point comes from content rather than a character count, so it stays correct
// if the word changes.
const tailWanted = String(hero.wordmarkTail ?? "").trim().toUpperCase();
const wordmarkTail = tailWanted && wordmark.endsWith(tailWanted) && wordmark !== tailWanted ? tailWanted : "";
const beforeTail = wordmarkTail ? wordmark.slice(0, -wordmarkTail.length) : wordmark;
// The character just before the tail carries an extra gap, so it clears the
// head instead of disappearing behind it.
const wordmarkPivot = wordmarkTail && beforeTail.length > 1 ? beforeTail.slice(-1) : "";
const wordmarkHead = wordmarkPivot ? beforeTail.slice(0, -1) : beforeTail;

// Meta chip: a claim, not a count. A client tally in the first screen invites
// the reader to weigh how small it is; both halves come from content.
const metaValue = String(hero.metaValue ?? "").trim();
const metaLabel = String(hero.metaLabel ?? "").trim();

const primaryCta = hero.primaryCta ?? {};
const secondaryCta = hero.secondaryCta ?? {};
const primaryHref = primaryCta.href ?? "#contact";
const primaryLabel = primaryCta.label ?? "Projekt anfragen";
const secondaryHref = secondaryCta.href ?? "#work";
const secondaryLabel = secondaryCta.label ?? "Projekte ansehen";
---

<section class="hero" id="hero" aria-labelledby="hero-heading">
  <div class="hero-stage">
    <div class="hero-glow" aria-hidden="true"></div>
    {wordmark ? (
      <span class="hero-wordmark" aria-hidden="true">
        {wordmarkHead}{wordmarkPivot ? <span class="wm-pivot">{wordmarkPivot}</span> : null}{wordmarkTail ? <span class="wm-tail">{wordmarkTail}</span> : null}
      </span>
    ) : null}

    <img
      class="hero-portrait"
      src={portraitSrc}
      alt={portraitAlt}
      width="2300"
      height="2711"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />

    <div class="hero-grain" aria-hidden="true"></div>
    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="hero-shell">
      <div class="hero-meta" data-rise>
        {metaValue && metaLabel ? (
          <span class="hero-chip">
            <strong>{metaValue}</strong>
            <span>{metaLabel}</span>
          </span>
        ) : <span></span>}
        {tag ? <p class="hero-tag">{tag}</p> : null}
      </div>

      <div class="hero-content">
        <h1 id="hero-heading" class="hero-title" data-rise style="--rise-delay:70ms">{headline}</h1>

        {lead ? (
          <p class="hero-lead" data-rise style="--rise-delay:140ms">{lead}</p>
        ) : null}

        <div class="hero-actions" data-rise style="--rise-delay:210ms">
          <a href={primaryHref} class="btn btn-primary">
            {primaryLabel}
            <svg class="btn-arrow h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
          <a href={secondaryHref} class="btn btn-on-dark">{secondaryLabel}</a>
        </div>

        {ctaNote ? (
          <p class="hero-note" data-rise style="--rise-delay:270ms">{ctaNote}</p>
        ) : null}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // One orchestrated entrance, run once on load. The hidden start state is set
  // from script so the hero is fully visible when JS is unavailable.
  (function () {
    var hero = document.getElementById("hero");
    if (!hero) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    hero.classList.add("is-anim");
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        hero.classList.add("is-ready");
      });
    });

    // The tail of the wordmark drops as soon as the page starts moving, and
    // springs back at the top. A threshold rather than a scroll-linked value,
    // because the overshoot is what makes it read as a bounce.
    var ticking = false;
    function syncScrolled() {
      ticking = false;
      hero.classList.toggle("is-scrolled", window.scrollY > 24);
    }
    syncScrolled();
    window.addEventListener(
      "scroll",
      function () {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(syncScrolled);
      },
      { passive: true }
    );
  })();
</script>
