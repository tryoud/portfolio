---
// Shared site header for both language routes. Previously this markup lived
// twice, inline in src/pages/index.astro and src/pages/en/index.astro, which
// meant every nav change had to be made in two places.
//
// Over the hero it is transparent and carries the hero palette; past the hero
// it becomes a solid themed bar.
interface Props {
  site: Record<string, any>;
  lang?: "de" | "en";
}

const { site, lang = "de" } = Astro.props as Props;
const en = lang === "en";
const base = en ? "/en/" : "";
const href = (hash: string) => `${base}${hash}`;

const nav = site.nav ?? {};
const navItems = [
  { id: "services", label: nav.services ?? "Services" },
  { id: "work", label: nav.work ?? (en ? "Work" : "Projekte") },
  { id: "process", label: nav.process ?? (en ? "Process" : "Ablauf") },
  { id: "about", label: nav.about ?? (en ? "About" : "Über mich") },
  { id: "contact", label: nav.contact ?? (en ? "Contact" : "Kontakt") },
];

const ctaLabel = site.navCtaLabel ?? (en ? "Start a project" : "Projekt anfragen");
const secondaryLabel = site.hero?.secondaryCta?.label ?? (en ? "View work" : "Projekte ansehen");
const secondaryHref = site.hero?.secondaryCta?.href ?? "#work";
const menuLabel = en ? "Menu" : "Menü";

const menu = site.menu ?? {};
const menuKicker = menu.kicker ?? (en ? "Let's build something" : "Lass uns etwas bauen");
const menuHeading = menu.heading ?? (en ? "worth showing off." : "das sich sehen lässt.");
const menuText = menu.text ?? site.hero?.lead ?? "";

const metaValue = site.hero?.metaValue ?? "";
const metaLabel = site.hero?.metaLabel ?? "";
---

<header class="site-head" id="site-head">
  <div class="head-bar">
    <a href={href("#top")} id="logo-link" class="head-logo">
      <span class="head-logo-mark" aria-hidden="true">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18V6l12 12V6" /></svg>
      </span>
      {site.name}
    </a>

    <nav class="head-nav" aria-label={en ? "Sections" : "Bereiche"}>
      {navItems.map((item) => <a href={href(`#${item.id}`)}>{item.label}</a>)}
    </nav>

    <div class="head-side">
      <span class="head-lang">
        {en ? <a href="/" class="lang-switch">DE</a> : <span aria-current="page">DE</span>}
        <span class="head-lang-sep" aria-hidden="true">/</span>
        {en ? <span aria-current="page">EN</span> : <a href="/en/" class="lang-switch">EN</a>}
      </span>

      <button type="button" id="theme-toggle" class="head-icon-btn" aria-label="Enable dark mode">
        <svg class="theme-icon-moon h-[1.125rem] w-[1.125rem]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
        <svg class="theme-icon-sun hidden h-[1.125rem] w-[1.125rem]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
      </button>

      <a href={href("#contact")} class="head-cta">
        {ctaLabel}
        <svg class="btn-arrow" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>

      <button
        type="button"
        id="head-menu-btn"
        class="head-icon-btn head-menu"
        aria-label={menuLabel}
        aria-expanded="false"
        aria-controls="head-panel"
      >
        <svg class="menu-icon-open h-[1.125rem] w-[1.125rem]" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M4 8h16M4 16h16" /></svg>
        <svg class="menu-icon-close hidden h-[1.125rem] w-[1.125rem]" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
  </div>

  <div class="head-panel" id="head-panel">
    {metaValue && metaLabel ? (
      <div class="head-panel-meta">
        <strong>{metaValue}</strong>
        <span>{metaLabel}</span>
      </div>
    ) : null}

    <nav class="head-panel-nav" aria-label={en ? "Sections" : "Bereiche"}>
      {navItems.map((item) => <a href={href(`#${item.id}`)} data-head-panel-link>{item.label}</a>)}
    </nav>

    <div class="head-panel-foot">
      <p class="head-panel-kicker">{menuKicker}</p>
      <h2>{menuHeading}</h2>
      {menuText ? <p>{menuText}</p> : null}
      <div class="head-panel-actions">
        <a href={href("#contact")} class="btn btn-primary" data-head-panel-link>
          {ctaLabel}
          <svg class="btn-arrow h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
        <a href={href(secondaryHref)} class="btn btn-on-dark" data-head-panel-link>{secondaryLabel}</a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var head = document.getElementById("site-head");
    var btn = document.getElementById("head-menu-btn");
    var panel = document.getElementById("head-panel");

    // Solid header only once the hero is behind us; over the hero it stays
    // transparent so the header reads as part of the opening composition.
    // The hero is looked up per call because this script runs before <main>
    // has been parsed.
    //
    // window.__syncThemeColor also drives the <meta name="theme-color"> tag,
    // which is what iOS Safari actually reads for its status bar / address
    // bar fill. html/body background-color is only a fallback WebKit uses
    // for the rubber-band bounce itself, and it turned out to be resampled
    // at inconsistent moments (page settle / bounce), not live on every
    // scroll frame. The meta tag is the mechanism browsers keep in sync
    // continuously; exposed on window so the theme-toggle script (below)
    // can call it too.
    //
    // Dynamic contract (user-confirmed 2026-09-11): dark (#130e0b) while on
    // the hero, page background once the hero is behind us. Driven from the
    // same `past` state as the header, synchronously in the scroll handler —
    // rAF-throttled updates arrived late on iOS momentum scrolling and left
    // the top strip showing the stale colour after scrolling back up.
    window.__syncThemeColor = function (past) {
      var meta = document.getElementById("theme-color-meta");
      if (!meta) return;
      var dark = document.documentElement.classList.contains("dark");
      meta.setAttribute("content", past ? (dark ? "#1c1917" : "#fdfbf7") : "#130e0b");
    };

    if (head) {
      function sync() {
        var hero = document.getElementById("hero");
        var past = hero
          ? hero.getBoundingClientRect().bottom <= 72
          : window.scrollY > 8;
        head.classList.toggle("is-stuck", past);
        // Keeps the overscroll canvas dark while the hero is on screen.
        // Two states: "hero-near" while any part of the hero is still visible
        // (canvas must be hero-ink — otherwise iOS rubber-banding up shows the
        // page colour above the hero), "past-hero" once the hero is behind us.
        var heroNear = hero ? hero.getBoundingClientRect().bottom > 0 : window.scrollY <= 8;
        document.documentElement.classList.toggle("hero-near", heroNear);
        document.documentElement.classList.toggle("past-hero", past);
        window.__syncThemeColor(past);
      }
      sync();
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", sync);
      }
      // Synchronous: two class toggles + one meta write are cheap, and any
      // rAF gate delays the swap past iOS Safari's momentum-scroll commit,
      // leaving the stale colour visible after scrolling back into the hero.
      window.addEventListener("scroll", sync, { passive: true });
      window.addEventListener("resize", sync, { passive: true });
      // bfcache restores (back/forward) fire neither load nor scroll.
      window.addEventListener("pageshow", sync);
      // iOS Safari throttles scroll events (and skips rAF) during momentum
      // scrolling, so the theme-color swap can land late and the status-bar
      // fill flashes the wrong colour mid-flick. An IntersectionObserver on
      // the hero fires reliably on iOS as the hero crosses the viewport edge.
      if (window.IntersectionObserver) {
        var heroEl = document.getElementById("hero");
        if (heroEl) {
          var io = new IntersectionObserver(function () { sync(); }, {
            threshold: [0, 0.01, 0.99, 1]
          });
          io.observe(heroEl);
        }
      }
    }

    if (head && btn && panel) {
      var openIcon = btn.querySelector(".menu-icon-open");
      var closeIcon = btn.querySelector(".menu-icon-close");

      function setOpen(open) {
        head.classList.toggle("is-open", open);
        btn.setAttribute("aria-expanded", open ? "true" : "false");
        document.documentElement.classList.toggle("menu-open", open);
        if (openIcon) openIcon.classList.toggle("hidden", open);
        if (closeIcon) closeIcon.classList.toggle("hidden", !open);
      }

      btn.addEventListener("click", function () {
        setOpen(btn.getAttribute("aria-expanded") !== "true");
      });

      panel.querySelectorAll("[data-head-panel-link]").forEach(function (a) {
        a.addEventListener("click", function () {
          setOpen(false);
        });
      });

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") setOpen(false);
      });

      window.addEventListener("resize", function () {
        if (window.innerWidth >= 900) setOpen(false);
      });
    }
  })();
</script>

<script is:inline>
  (function () {
    var btn = document.getElementById("theme-toggle");
    var moon = btn && btn.querySelector(".theme-icon-moon");
    var sun = btn && btn.querySelector(".theme-icon-sun");
    function applyDark(dark) {
      document.documentElement.classList.toggle("dark", dark);
      localStorage.setItem("theme", dark ? "dark" : "light");
      if (moon) moon.classList.toggle("hidden", dark);
      if (sun) sun.classList.toggle("hidden", !dark);
      if (btn) btn.setAttribute("aria-label", dark ? "Enable light mode" : "Enable dark mode");
      // Re-run with the current scroll state so the status-bar colour picks
      // up the new theme immediately if we're already past the hero.
      if (window.__syncThemeColor) {
        window.__syncThemeColor(document.documentElement.classList.contains("past-hero"));
      }
    }
    if (btn) {
      btn.addEventListener("click", function () {
        applyDark(!document.documentElement.classList.contains("dark"));
      });
      var isDark = document.documentElement.classList.contains("dark");
      if (moon) moon.classList.toggle("hidden", isDark);
      if (sun) sun.classList.toggle("hidden", !isDark);
      btn.setAttribute("aria-label", isDark ? "Enable light mode" : "Enable dark mode");
    }

    var logo = document.getElementById("logo-link");
    if (logo) {
      logo.addEventListener("click", function (e) {
        var h = logo.getAttribute("href");
        if (h === "#top" || h === "/en/#top") {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: "smooth" });
        }
      });
    }

    // Keep the scroll position when switching language.
    document.querySelectorAll("a.lang-switch").forEach(function (a) {
      a.addEventListener("click", function (e) {
        e.preventDefault();
        sessionStorage.setItem("langSwitchScroll", String(window.scrollY || 0));
        window.location.href = a.getAttribute("href");
      });
    });
  })();
</script>
