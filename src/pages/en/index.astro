---
import "../../styles/global.css";
import site from "../../../content/site.en.json";
import SiteHeader from "../../components/SiteHeader.astro";
import Hero from "../../components/sections/Hero.astro";
import Clients from "../../components/sections/Clients.astro";
import Services from "../../components/sections/Services.astro";
import Work from "../../components/sections/Work.astro";
import Process from "../../components/sections/Process.astro";
import Media from "../../components/sections/Media.astro";
import About from "../../components/sections/About.astro";
import Faq from "../../components/sections/Faq.astro";
import Contact from "../../components/sections/Contact.astro";

const siteUrl = (site as { siteUrl?: string }).siteUrl || "https://nikolasmaerker.com";
const ogImage = (site as { ogImage?: string }).ogImage || "/og.png";
const twitterHandle = (site as { twitterHandle?: string }).twitterHandle ?? "";
const baseUrl = siteUrl.replace(/\/$/, "");
const canonical = `${baseUrl}/en/`;
const ogImageUrl = ogImage ? (ogImage.startsWith("http") ? ogImage : `${baseUrl}${ogImage.startsWith("/") ? "" : "/"}${ogImage}`) : "";
const title = `${site.name} — ${site.role}`;
const description = site.tagline ?? "";
const links = (site as { links?: { github?: string; linkedin?: string; instagram?: string } }).links ?? {};
const sameAs = [links.github, links.linkedin, links.instagram].filter(Boolean);
const faqItems = (site as { faq?: { items?: { q?: string; a?: string }[] } }).faq?.items?.filter((i) => i?.q && i?.a) ?? [];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    ...(faqItems.length
      ? [
          {
            "@type": "FAQPage",
            "@id": `${baseUrl}/en/#faq`,
            mainEntity: faqItems.map((item) => ({
              "@type": "Question",
              name: item.q,
              acceptedAnswer: { "@type": "Answer", text: item.a },
            })),
          },
        ]
      : []),
    {
      "@type": "ProfessionalService",
      "@id": `${baseUrl}/#business`,
      name: site.name,
      url: canonical,
      description,
      image: ogImageUrl || undefined,
      founder: { "@id": `${baseUrl}/#person` },
      sameAs,
    },
    {
      "@type": "Person",
      "@id": `${baseUrl}/#person`,
      name: site.name,
      jobTitle: site.role,
      url: canonical,
      sameAs,
    },
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <!-- Mirrors --hero-ink / --bg: iOS Safari colours its status bar and
         address bar from this tag (not from html/body background-color),
         and only theme-color updates reliably while the page is mid-scroll.
         Kept in sync with the hero/content boundary by SiteHeader.astro. -->
    <meta name="theme-color" id="theme-color-meta" content="#130e0b" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const dark = stored === "dark" || (stored !== "light" && prefersDark);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical ? <link rel="canonical" href={canonical} /> : null}
    <link rel="alternate" hreflang="de" href={`${baseUrl}/`} />
    <link rel="alternate" hreflang="en" href={`${baseUrl}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${baseUrl}/`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImageUrl ? <meta property="og:image" content={ogImageUrl} /> : null}
    {canonical ? <meta property="og:url" content={canonical} /> : null}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl ? <meta name="twitter:image" content={ogImageUrl} /> : null}
    {twitterHandle ? <meta name="twitter:site" content={twitterHandle} /> : null}
    <link rel="preload" href="/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>

  <body class="min-h-screen clip-x bg-[var(--bg)] text-[var(--text)] antialiased">
    <div id="top" aria-hidden="true"></div>
    <script is:inline>
      (function () {
        var y = sessionStorage.getItem("langSwitchScroll");
        if (y !== null) {
          sessionStorage.removeItem("langSwitchScroll");
          y = parseInt(y, 10);
          if (!isNaN(y)) {
            function restore() { window.scrollTo(0, y); }
            if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", restore);
            else restore();
          }
        }
      })();
    </script>
    <SiteHeader site={site} lang="en" />

    <main>
      <Hero site={site} />
      <Clients site={site} />
      <Services site={site} />
      <Work site={site} />
      <Process site={site} />
      <Media site={site} />
      <About site={site} />
      <Faq site={site} />
      <Contact site={site} lang="en" />
    </main>

    <!-- Sticky mobile CTA: the nav CTA scrolls away on phones, so keep one
         reachable at all times once the user is past the hero. -->
    <div class="mobile-cta" id="mobile-cta" aria-hidden="true">
      <a href="#contact" class="btn btn-primary w-full" tabindex="-1">
        {(site as { navCtaLabel?: string }).navCtaLabel ?? "Contact"}
      </a>
    </div>
    <script is:inline>
      (function () {
        var bar = document.getElementById("mobile-cta");
        var contact = document.getElementById("contact");
        if (!bar) return;
        var link = bar.querySelector("a");

        function setShown(shown) {
          if (bar.classList.contains("is-visible") === shown) return;
          bar.classList.toggle("is-visible", shown);
          bar.setAttribute("aria-hidden", shown ? "false" : "true");
          if (link) link.tabIndex = shown ? 0 : -1;
        }

        var ticking = false;
        function update() {
          ticking = false;
          // Show once the hero is behind us, hide again over the contact form
          // so the bar never covers the fields it points to.
          var hero = document.getElementById("hero");
          var pastHero = hero
            ? hero.getBoundingClientRect().bottom < 0
            : window.scrollY > window.innerHeight * 0.75;
          var atContact = contact
            ? contact.getBoundingClientRect().top < window.innerHeight * 0.85
            : false;
          setShown(pastHero && !atContact);
        }

        function onScroll() {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(update);
        }

        update();
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
      })();
    </script>
  </body>
</html>
